# Supabase Configuration
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI API Keys
VITE_GEMINI_API_KEY=your-google-gemini-api-key
VITE_OPENROUTER_API_KEY=your-openrouter-api-key

# Meta WhatsApp Cloud API Configuration
# NOTE: VITE_WHATSAPP_PHONE_ID must be the 'Phone number ID' from WhatsApp > API Setup (Step 1), NOT the WABA ID.
VITE_WHATSAPP_PHONE_ID=your-phone-number-id
VITE_WHATSAPP_WABA_ID=your-whatsapp-business-account-id
VITE_WHATSAPP_ACCESS_TOKEN=your-meta-access-token

